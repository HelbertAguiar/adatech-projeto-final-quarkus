# Build completo no Docker. Nao exige Maven nem JDK instalados no host.
FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /build
COPY pom.xml ./
COPY src ./src
RUN DB_PASSWORD=build-only-placeholder mvn -B -ntp -DskipTests -DskipITs package

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /build/target/quarkus-app/ /app/
EXPOSE 9091
ENV QUARKUS_HTTP_HOST=0.0.0.0
USER 1001
ENTRYPOINT ["java", "-jar", "/app/quarkus-run.jar"]
