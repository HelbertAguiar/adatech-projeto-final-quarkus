    {
      "name": "02 - CRUD Panache - executar na ordem",
      "item": [
        {
          "name": "1. Listar produtos persistidos",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/produtos",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Produtos seed H2 carregados', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.be.an('array');",
                  "  // Apenas no profile dev/test, PostgreSQL comeca vazio.",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Filtrar por nome",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/produtos?nome=cade",
            "description": "No H2 dev, deve encontrar Caderno. Em PostgreSQL sem seed pode vir vazio."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Criar produto - salva produtoId",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/produtos",
            "description": "",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Mochila\",\n  \"preco\": 79.9,\n  \"quantidade\": 4\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Criacao devolve HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.test('ID e Location presentes', () => {",
                  "  const produto = pm.response.json();",
                  "  pm.expect(produto.id).to.be.a('number');",
                  "  pm.expect(produto.nome).to.eql('Mochila');",
                  "  pm.expect(pm.response.headers.get('Location')).to.include('/produtos/');",
                  "  pm.collectionVariables.set('produtoId', String(produto.id));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Buscar produto pelo ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/produtos/{{produtoId}}",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('ID coincide com o criado', () => pm.expect(String(pm.response.json().id)).to.eql(pm.collectionVariables.get('produtoId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "5. Atualizar produto",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/produtos/{{produtoId}}",
            "description": "",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Mochila escolar\",\n  \"preco\": 89.9,\n  \"quantidade\": 8\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Dados atualizados', () => {",
                  "  const data = pm.response.json();",
                  "  pm.expect(data.nome).to.eql('Mochila escolar');",
                  "  pm.expect(data.quantidade).to.eql(8);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "6. Conferir alteracao",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/produtos/{{produtoId}}",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('ID coincide com o criado', () => pm.expect(String(pm.response.json().id)).to.eql(pm.collectionVariables.get('produtoId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "7. Excluir produto",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/produtos/{{produtoId}}",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 204 sem body', () => {",
                  "  pm.response.to.have.status(204);",
                  "  pm.expect(pm.response.text()).to.eql('');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "8. Buscar depois de excluir (404)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/produtos/{{produtoId}}",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
