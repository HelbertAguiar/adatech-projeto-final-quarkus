                ]
              }
            }
          ]
        },
        {
          "name": "08 - Retirada maior que estoque (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/produtos/{{produtoId}}/retiradas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "produtos",
                "{{produtoId}}",
                "retiradas"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantidade\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"Código ESTOQUE_INSUFICIENTE\", () => pm.expect(pm.response.json().codigo).to.eql(\"ESTOQUE_INSUFICIENTE\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "09 - Confirmar estoque inalterado após 409",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/produtos/{{produtoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "produtos",
                "{{produtoId}}"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Estoque continua 2\", () => pm.expect(pm.response.json().quantidade).to.eql(2));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
