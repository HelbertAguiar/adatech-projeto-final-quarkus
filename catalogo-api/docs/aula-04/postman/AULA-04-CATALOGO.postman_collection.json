    {
      "name": "02 • DEMO B — MicroProfile Health",
      "description": "Estas probes avaliam a execução da API e sua configuração, não a disponibilidade do Estoque Local. Continue a testá-las depois de desligar o estoque.",
      "item": [
        {
          "name": "02.1 • GET /q/health/live — Liveness",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/q/health/live",
            "description": "@Liveness no CatalogoLivenessCheck. Em Kubernetes pode ser configurado como livenessProbe."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "",
                  "pm.test(\"HTTP 200 — Liveness\", () => pm.response.to.have.status(200));",
                  "const dados = pm.response.json();",
                  "pm.test(\"Status global UP\", () => pm.expect(dados.status).to.eql(\"UP\"));",
                  "pm.test(\"Check catalogo-vivo presente e UP\", () => pm.expect((dados.checks || []).find(c => c.name === \"catalogo-vivo\")?.status).to.eql(\"UP\"));",
                  "",
                  "pm.test(\"Content-Type JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\") || \"\").to.include(\"application/json\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "02.2 • GET /q/health/ready — Readiness",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/q/health/ready",
            "description": "@Readiness no CatalogoReadinessCheck. Confere que catalogo.nome não está em branco. Em Kubernetes pode ser usado como readinessProbe."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "",
                  "pm.test(\"HTTP 200 — Readiness\", () => pm.response.to.have.status(200));",
                  "const dados = pm.response.json();",
                  "pm.test(\"Status global UP\", () => pm.expect(dados.status).to.eql(\"UP\"));",
                  "pm.test(\"Check catalogo-configurado presente e UP\", () => pm.expect((dados.checks || []).find(c => c.name === \"catalogo-configurado\")?.status).to.eql(\"UP\"));",
                  "",
                  "pm.test(\"Content-Type JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\") || \"\").to.include(\"application/json\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "02.3 • GET /q/health — agregado",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/q/health",
            "description": "Resposta consolidada de checks como catalogo-vivo e catalogo-configurado. A ordem no array checks não é significativa."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "",
                  "pm.test(\"HTTP 200 — Health agregado\", () => pm.response.to.have.status(200));",
                  "const dados = pm.response.json();",
                  "pm.test(\"Status global UP\", () => pm.expect(dados.status).to.eql(\"UP\"));",
                  "pm.test(\"Contém liveness do catálogo\", () => pm.expect((dados.checks || []).some(c => c.name === \"catalogo-vivo\" && c.status === \"UP\")).to.be.true);",
                  "pm.test(\"Contém readiness do catálogo\", () => pm.expect((dados.checks || []).some(c => c.name === \"catalogo-configurado\" && c.status === \"UP\")).to.be.true);",
                  "",
                  "pm.test(\"Content-Type JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\") || \"\").to.include(\"application/json\"); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 • DEMO C — Retry, Fallback e recuperação",
      "description": "Execute os requests NA ORDEM. 1) Estoque ativo → 200; 2) pare o processo de estoque (Ctrl+C) ou docker stop estoque-local → 503; 3) probes continuam UP; 4) reative estoque ou docker start estoque-local → 200. Postman NÃO para/inicia contêiner automaticamente.",
      "item": [
        {
          "name": "03.1 • GET /products — sucesso (estoque ativo)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/products",
            "description": "Pré-condição: estoque ligado. @Retry não precisa intervir. Origem ESTOQUE e HTTP 200."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "",
                  "pm.test(\"HTTP 200 — estoque disponível\", () => pm.response.to.have.status(200));",
                  "const dados = pm.response.json();",
                  "pm.test(\"Origem ESTOQUE (sem fallback)\", () => pm.expect(dados.origem).to.eql(\"ESTOQUE\"));",
                  "pm.test(\"Total = 2 produtos disponíveis\", () => pm.expect(dados.total).to.eql(2));",
                  "pm.test(\"Retorna 2 itens no array\", () => pm.expect(dados.products).to.be.an(\"array\").with.lengthOf(2));",
                  "pm.test(\"Produtos têm estoque positivo\", () => pm.expect(dados.products.every(p => p.stock > 0)).to.be.true);",
                  "pm.test(\"Nomes do catálogo correspondem ao estoque\", () => pm.expect(dados.products.map(p => p.name)).to.have.members([\"Caderno\", \"Caneta\"]));",
                  "pm.test(\"Pasta sem estoque não aparece\", () => pm.expect(dados.products.some(p => p.name === \"Pasta\")).to.be.false);",
                  "",
                  "pm.test(\"Content-Type JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\") || \"\").to.include(\"application/json\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "03.2 • GET /products — falha e fallback (estoque parado)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/products",
            "description": "AÇÃO MANUAL ANTES DE ENVIAR: pare o Estoque Local no terminal (Ctrl+C), ou docker stop estoque-local. Quarkus executa até 2 retries além da chamada inicial e faz @Fallback. Deve retornar 503, origem FALLBACK, total 0."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "",
                  "pm.test(\"HTTP 503 — Service Unavailable\", () => pm.response.to.have.status(503));",
                  "const dados = pm.response.json();",
                  "pm.test(\"Fallback ativado\", () => pm.expect(dados.origem).to.eql(\"FALLBACK\"));",
                  "pm.test(\"Total = 0\", () => pm.expect(dados.total).to.eql(0));",
                  "pm.test(\"Não inventa produtos quando a dependência falha\", () => pm.expect(dados.products).to.be.an(\"array\").that.is.empty);",
                  "",
                  "pm.test(\"Content-Type JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\") || \"\").to.include(\"application/json\"); });"
                ]
              }
            }
          ]
        },
